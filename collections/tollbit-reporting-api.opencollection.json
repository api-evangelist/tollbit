{
  "opencollection": "1.0.0",
  "info": {
    "name": "TollBit Auth Tokens Reporting API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "Reporting",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ReportingService_reportContentUsage",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.tollbit.com/dev/v2/transactions/selfReport",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "TollbitKey",
              "value": "{{TollbitKey}}",
              "placement": "header"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}