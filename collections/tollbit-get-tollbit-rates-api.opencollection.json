{
  "opencollection": "1.0.0",
  "info": {
    "name": "TollBit Auth Tokens Get Tollbit Rates API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "Get Tollbit Rates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "ContentService_batchGetRates",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.tollbit.com/dev/v2/rates/batch",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "TollbitKey",
              "value": "{{TollbitKey}}",
              "placement": "header"
            }
          }
        },
        {
          "info": {
            "name": "ContentService_getRates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://gateway.tollbit.com/dev/v2/rates/:contentUrl",
            "params": [
              {
                "name": "contentUrl",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "TollbitKey",
              "value": "{{TollbitKey}}",
              "placement": "header"
            }
          }
        }
      ]
    }
  ],
  "bundled": true
}