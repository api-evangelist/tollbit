            "url": {
              "path": [
                "dev",
                "v2",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) "
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "<integer>",
                  "description": "Number of results to return. Maximum value is 20."
                },
                {
                  "disabled": false,
                  "key": "next-token",
                  "value": "<string>",
                  "description": "Token for pagination. If provided, continues from the encoded page. If not provided, returns first page."
                },
                {
                  "disabled": false,
                  "key": "properties",
                  "value": "<string>",
                  "description": "Comma-separated list of domains (max 20) to boost in search results. When provided, generates a custom goggle string."
                },
                {
                  "disabled": false,
                  "key": "allowedOnly",
                  "value": "<boolean>",
                  "description": "When true, restrict search to properties the calling org is allowed to access.\nIntersects with `properties` when both are provided.\nCurrently mirrors `readyToLicense`; will be expanded to broader allowlist semantics later."
                },
                {
                  "disabled": false,
                  "key": "readyToLicense",
                  "value": "<boolean>",
                  "description": "When true, restrict search to properties ready to license (rates-enabled / content-catalog path). Intersects with `properties` when both are provided. Currently equivalent to `allowedOnly`."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
